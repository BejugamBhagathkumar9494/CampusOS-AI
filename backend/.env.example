# General Settings
PROJECT_NAME="CampusOS AI"
DEBUG=true
API_V1_STR="/api/v1"

# Database Settings (Local Docker postgres by default)
DATABASE_URL="postgresql://campusos_admin:campusos_secure_pass_2026@localhost:5432/campusos_db"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"

# Security & JWT Authentication
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET_KEY="replace_this_with_a_super_secure_random_hex_key_for_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
MICROSOFT_CLIENT_ID="your-microsoft-client-id"
MICROSOFT_CLIENT_SECRET="your-microsoft-client-secret"

# Supabase Storage Settings
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-anon-key"
SUPABASE_BUCKET_NAME="campusos-media"

# AI Stack Configuration
OPENAI_API_KEY="sk-proj-your-openai-api-key"
LLAMA_API_BASE="https://api.together.xyz/v1" # or similar provider
LLAMA_API_KEY="your-llama-api-key"
MISTRAL_API_KEY="your-mistral-api-key"
DEFAULT_EMBEDDING_MODEL="BAAI/bge-large-en-v1.5"

# Environment
ENV="development"
